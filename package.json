{
  "name": "pagepith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Chrome extension that turns the useful core of a page into clean Markdown.",
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "node scripts/build.js",
    "test": "node --test",
    "test:snyk:dependencies": "snyk test --all-projects --severity-threshold=high",
    "test:snyk:code": "snyk code test --severity-threshold=high",
    "test:snyk": "npm run test:snyk:dependencies && npm run test:snyk:code",
    "check": "npm test && npm run build && npm run test:snyk"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "esbuild": "0.25.6",
    "jsdom": "29.1.1",
    "snyk": "1.1306.1"
  },
  "license": "MIT"
}
